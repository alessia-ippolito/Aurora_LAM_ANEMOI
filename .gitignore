# Aurora fields (extract_aurora_campi.py on Lightning)
aurora_campi*/

# Models and Lightning logs
modello/checkpoints/*
lightning_logs/
*.ckpt

# Large or derived data: recreated by the notebook and the scripts
*.parquet
*.csv.gz
*.nc
*.tif
*.tiff
*.npy
*.npz
*.pt

# Exception: the networks of the final model (train_downscaling_head.py, ~530 KB in total), the
# ones evaluated on the test set and used for the maps
!modello/checkpoints/*_finale.pt

