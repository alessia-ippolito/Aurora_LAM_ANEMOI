# Credentials (ADS, EUMETSAT, DTM): never on git
.env

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Downloaded data (API caches, recreated by the notebook)
arpa_lombardia_daily_cache_utc/
arpa_piemonte_daily_cache/
arpae_qq2_daily_cache/
ecad_padania_by_year/
ecad_padania_raw_cache/
